rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function staff() { return signedIn() && (me().role == 'admin' || me().role == 'moderator'); }
    function admin() { return signedIn() && me().role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'buyer';
      allow update: if admin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if admin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if staff();
    }
    match /products/{id} {
      allow read: if resource.data.status == 'active' || staff();
      allow create, update, delete: if staff();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || staff());
      allow update: if staff();
      allow delete: if admin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
    }
    match /messages/{id} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || staff());
      allow create: if signedIn() && (request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid || staff());
      allow update: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || staff());
    }
  }
}
